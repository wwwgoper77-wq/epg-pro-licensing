# ==============================================================================
# EPG-PRO Licensing Server Configuration Environment Variables
# ==============================================================================

# Port the server will bind to (defaults to 3000)
PORT=3000

# Base URL of your deployed application (required for reference / callbacks)
APP_URL=https://your-app-domain.com

# Cryptographic salt used for signing license status checks on Enigma2 receivers.
# CRITICAL: This must match the SECRET_SALT constant defined in the client's python plugin (plugin.py).
SIGNATURE_SECRET=EPG_ARABIC_SECRET_2026

# Administrator Dashboard login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Secret salt used for hashing administrative session tokens
ADMIN_SESSION_SECRET=EPG_SESSION_2026

# Path to the JSON data store for license keys and logs
DB_PATH=./licenses.json

# Gemini AI Key (If implementing translation translation proxies on the server)
GEMINI_API_KEY=your_gemini_api_key_here
